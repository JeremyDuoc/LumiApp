rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección partner_links (Vínculos de confianza de Lumi Bonds)
    match /partner_links/{linkId} {

      function changedOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function validSnapshot(prefix) {
        let data = request.resource.data;
        let snapshot = data.get(prefix + 'Snapshot', null);
        let sharePhase = data.get(prefix + 'SharePhase', false);
        let shareMood = data.get(prefix + 'ShareMood', false);
        let shareSymptoms = data.get(prefix + 'ShareSymptoms', false);
        let sharePredictions = data.get(prefix + 'SharePredictions', false);
        let consent = data.get(prefix + 'ConsentExplicitlyGranted', false);

        return snapshot == null || (snapshot is map
          // 1. Consentimiento explícito: sin él, no se puede enviar ningún dato de salud
          && (consent || (
            snapshot.get('currentPhase', 'UNKNOWN') == 'UNKNOWN'
            && snapshot.get('currentMood', null) == null
            && snapshot.get('topSymptoms', []) == []
            && snapshot.get('daysUntilNextPhase', 0) == 0
            && snapshot.get('late', false) == false
            && snapshot.get('delayDays', 0) == 0
            && snapshot.get('cycleStartDateMs', null) == null
            && snapshot.get('cycleLengthDays', 0) == 0
            && snapshot.get('periodLengthDays', 0) == 0
          ))
          // 2. SEC-P0-A: Si sharePhase es false, PROHIBIDO phase, cycleStartDateMs, cycleLengthDays y periodLengthDays
          && (sharePhase || (
            snapshot.get('currentPhase', 'UNKNOWN') == 'UNKNOWN'
            && snapshot.get('cycleStartDateMs', null) == null
            && snapshot.get('cycleLengthDays', 0) == 0
            && snapshot.get('periodLengthDays', 0) == 0
          ))
          // 3. Estado de ánimo: si shareMood es false, currentMood debe ser null
          && (shareMood || snapshot.get('currentMood', null) == null)
          // 4. Síntomas: si shareSymptoms es false, topSymptoms debe ser lista vacía
          && (shareSymptoms || snapshot.get('topSymptoms', []) == [])
          // 5. Predicciones: si sharePredictions es false, prohíbe métricas de retraso y fecha de inicio de ciclo
          && (sharePredictions || (
            snapshot.get('daysUntilNextPhase', 0) == 0
            && snapshot.get('late', false) == false
            && snapshot.get('delayDays', 0) == 0
            && snapshot.get('cycleStartDateMs', null) == null
          ))
        );
      }
      
      // P0-2 CORREGIDO: Lectura permitida EXCLUSIVAMENTE si el vínculo está ACTIVE.
      // Si está REVOKED, el acceso de lectura está bloqueado para ambos usuarios.
      // Los vínculos PENDING solo los puede leer el titular (owner).
      allow get: if request.auth != null && (
        (resource.data.status == 'ACTIVE' && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.partnerUid == request.auth.uid
        )) ||
        (resource.data.status == 'PENDING' && resource.data.ownerUid == request.auth.uid)
      );

      allow list: if request.auth != null && (
        (resource.data.status == 'ACTIVE' && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.partnerUid == request.auth.uid
        )) ||
        (resource.data.status == 'PENDING' && resource.data.ownerUid == request.auth.uid)
      );
      
      // Creación: Solo el titular, en estado PENDING, sin snapshots y con privacidad por defecto apagada (Opt-in)
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.linkId == linkId
        && request.resource.data.status == 'PENDING'
        && request.resource.data.partnerUid == null
        && request.resource.data.get('ownerSnapshot', null) == null
        && request.resource.data.get('partnerSnapshot', null) == null
        && request.resource.data.get('partnerFcmToken', null) == null
        && request.resource.data.get('ownerSharePhase', false) == false
        && request.resource.data.get('ownerShareMood', false) == false
        && request.resource.data.get('ownerShareSymptoms', false) == false
        && request.resource.data.get('ownerSharePredictions', false) == false;
      
      // Actualización de cliente:
      // 1. Participantes de un vínculo ACTIVE solo pueden modificar sus propios campos.
      // 2. Revocación autorizada: Titular o pareja pueden revocar, vaciando snapshots y tokens.
      // SEC-NEW-01 RESUELTO: Ningún cliente puede activar un vínculo PENDING directamente.
      // La activación la realiza exclusivamente la Cloud Function 'redeemBondsInvitation' (Admin SDK).
      allow update: if request.auth != null && (
        // Participante activo actualiza sus propios campos
        (resource.data.status == 'ACTIVE'
          && request.resource.data.status == 'ACTIVE'
          && ((resource.data.ownerUid == request.auth.uid
            && changedOnly(['ownerDisplayName', 'ownerAvatarId', 'ownerFcmToken',
              'ownerSharePhase', 'ownerShareMood', 'ownerShareSymptoms', 'ownerSharePredictions',
              'ownerConsentExplicitlyGranted', 'ownerSnapshot', 'lastOwnerCareAction', 'updatedAtMs'])
            && validSnapshot('owner'))
          || (resource.data.partnerUid == request.auth.uid
            && changedOnly(['partnerDisplayName', 'partnerAvatarId', 'partnerFcmToken',
              'partnerSharePhase', 'partnerShareMood', 'partnerShareSymptoms', 'partnerSharePredictions',
              'partnerConsentExplicitlyGranted', 'partnerSnapshot', 'lastPartnerCareAction', 'updatedAtMs'])
            && validSnapshot('partner'))))
        ||
        // Revocación desde cliente: debe vaciar snapshots y tokens inmediatamente
        (resource.data.status in ['PENDING', 'ACTIVE']
          && (resource.data.ownerUid == request.auth.uid || resource.data.partnerUid == request.auth.uid)
          && request.resource.data.status == 'REVOKED'
          && request.resource.data.get('ownerSnapshot', null) == null
          && request.resource.data.get('partnerSnapshot', null) == null
          && request.resource.data.get('ownerFcmToken', null) == null
          && request.resource.data.get('partnerFcmToken', null) == null
          && changedOnly(['status', 'ownerSnapshot', 'partnerSnapshot', 'ownerFcmToken', 'partnerFcmToken', 'revokedAtMs', 'revokedByUid', 'updatedAtMs']))
      );
      
      // Borrado: solo si el vínculo ya no está activo
      allow delete: if request.auth != null && (
        (resource.data.status == 'PENDING' && resource.data.ownerUid == request.auth.uid) ||
        (resource.data.status == 'REVOKED' && (resource.data.ownerUid == request.auth.uid || resource.data.partnerUid == request.auth.uid))
      );
    }

    // Invitaciones de pareja / Bonds:
    // P1-5 RESUELTO: Ningún extraño puede enumerar ni hacer get de invitaciones.
    // Solo el titular puede ver su propia invitación. El canje lo ejecuta la Cloud Function.
    match /partner_invitations/{code} {
      allow list: if false;

      allow get: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.status == 'PENDING'
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs > request.time.toMillis()
        && request.resource.data.expiresAtMs <= request.time.toMillis() + 7 * 24 * 60 * 60 * 1000;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'REVOKED'
        && changedOnly(['status', 'revokedAtMs']);

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    
    // Tablas de uso interno del backend (Rate limiting)
    match /_rate_limits/{uid} {
      allow read, write: if false;
    }

    // Perfiles de usuario
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Diario compartido entre miembros de un vínculo ACTIVE
    match /diaries/{linkId}/entries/{entryId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/partner_links/$(linkId))
        && get(/databases/$(database)/documents/partner_links/$(linkId)).data.status == 'ACTIVE'
        && (
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.ownerUid == request.auth.uid
          ||
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.partnerUid == request.auth.uid
        );

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && exists(/databases/$(database)/documents/partner_links/$(linkId))
        && get(/databases/$(database)/documents/partner_links/$(linkId)).data.status == 'ACTIVE'
        && (
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.ownerUid == request.auth.uid
          ||
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.partnerUid == request.auth.uid
        );

      allow update: if false;

      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/partner_links/$(linkId))
        && get(/databases/$(database)/documents/partner_links/$(linkId)).data.status == 'ACTIVE'
        && (
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.ownerUid == request.auth.uid
          ||
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.partnerUid == request.auth.uid
        );
    }
  }
}
