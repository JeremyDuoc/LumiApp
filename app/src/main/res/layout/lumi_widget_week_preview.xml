<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="16dp" android:background="@drawable/lumi_widget_preview_card"
    android:orientation="vertical" android:gravity="start">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/lumi_widget_flower" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:text="lumi"
            android:textColor="#FAF8FB" android:fontFamily="sans-serif-medium" android:textSize="15sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/widget_week_title"
            android:textColor="#AAA3B5" android:textSize="12sp"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="17dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:text="14" android:textColor="#FAF8FB" android:textSize="13sp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:text="15" android:textColor="#FAF8FB" android:textSize="13sp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:text="16" android:textColor="#FAF8FB" android:textSize="13sp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:text="17" android:textColor="#FAF8FB" android:textSize="13sp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:text="18" android:textColor="#FAF8FB" android:textSize="13sp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:text="19" android:textColor="#FAF8FB" android:textSize="13sp"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center" android:text="20" android:textColor="#FAF8FB" android:textSize="13sp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="4dp"
        android:background="@drawable/lumi_widget_preview_progress"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_estimation_note"
        android:textColor="#AAA3B5" android:textSize="10sp"/>
</LinearLayout>