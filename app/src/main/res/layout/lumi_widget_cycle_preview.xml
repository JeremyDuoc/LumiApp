<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="17dp" android:background="@drawable/lumi_widget_preview_card"
    android:orientation="vertical" android:gravity="start">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/lumi_widget_flower" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:text="lumi"
            android:textColor="#FAF8FB" android:fontFamily="sans-serif-medium"
            android:textSize="16sp"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="12dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_preview_day"
        android:fontFamily="sans-serif-medium" android:textColor="#FAF8FB"
        android:textSize="28sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/pm_phase_follicular" android:textColor="#CBB4F1"
        android:textSize="12sp"/>
    <Space android:layout_width="1dp" android:layout_height="11dp"/>
    <View android:layout_width="match_parent" android:layout_height="5dp"
        android:background="@drawable/lumi_widget_preview_progress"/>
</LinearLayout>