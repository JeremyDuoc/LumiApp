<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="13dp" android:background="@drawable/lumi_widget_preview_card"
    android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:layout_width="29dp" android:layout_height="29dp"
        android:src="@drawable/lumi_widget_flower" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="10dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="lumi" android:fontFamily="sans-serif-medium"
            android:textColor="#FAF8FB" android:textSize="19sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_quiet_subtitle"
            android:textColor="#AAA3B5" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>