<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- No usage telemetry without a separately designed opt-in flow. -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <!-- Bonds is not part of the initial release. Avoid registering messaging tokens. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <service
            android:name="com.jeremy.lumi.notification.FcmService"
            tools:node="remove" />
    </application>
</manifest>
