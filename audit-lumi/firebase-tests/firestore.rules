rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // periodos para la colección partner_links
    match /partner_links/{linkId} {

      function changedOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function validSnapshot(prefix) {
        let data = request.resource.data;
        let snapshot = data.get(prefix + 'Snapshot', null);
        return snapshot == null || (snapshot is map
          && (data.get(prefix + 'SharePhase', true) || snapshot.get('currentPhase', 'UNKNOWN') == 'UNKNOWN')
          && (data.get(prefix + 'ShareMood', true) || snapshot.get('currentMood', null) == null)
          && (data.get(prefix + 'ShareSymptoms', false) || snapshot.get('topSymptoms', []) == [])
          && (data.get(prefix + 'SharePredictions', true) || (
            snapshot.get('daysUntilNextPhase', 0) == 0 && snapshot.get('late', false) == false
            && snapshot.get('delayDays', 0) == 0 && snapshot.get('cycleStartDateMs', null) == null
            && snapshot.get('cycleLengthDays', 0) == 0 && snapshot.get('periodLengthDays', 0) == 0
          )));
      }
      
      // Permitir lectura get/list exclusivamente a participantes legítimos (owner o partner)
      // LUM-01 corregido: eliminada excepción pública de PENDING para prevenir descubrimiento no autorizado.
      allow get: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.partnerUid == request.auth.uid
      );

      allow list: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.partnerUid == request.auth.uid
      );
      
      // Permitir creación si:
      // 1. Estás autenticado
      // 2. Te pones a ti mismo como owner
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.linkId == linkId
        && request.resource.data.status == 'PENDING'
        && request.resource.data.partnerUid == null
        && request.resource.data.get('ownerSnapshot', null) == null
        && request.resource.data.get('partnerSnapshot', null) == null
        && request.resource.data.get('partnerFcmToken', null) == null;
      
      // Permitir actualización si:
      // 1. Eres el dueño o la pareja y mantienes esa posición
      // 2. O eres un usuario nuevo uniéndote a un link PENDING (tu UID se vuelve partnerUid)
      allow update: if request.auth != null && (
        // Cada participante solo modifica sus propios campos; las identidades son inmutables.
        (resource.data.status in ['PENDING', 'ACTIVE']
          && request.resource.data.status == resource.data.status
          && ((resource.data.ownerUid == request.auth.uid
            && changedOnly(['ownerDisplayName', 'ownerAvatarId', 'ownerFcmToken',
              'ownerSharePhase', 'ownerShareMood', 'ownerShareSymptoms', 'ownerSharePredictions',
              'ownerSnapshot', 'lastOwnerCareAction']) && validSnapshot('owner'))
          || (resource.data.partnerUid == request.auth.uid
            && changedOnly(['partnerDisplayName', 'partnerAvatarId', 'partnerFcmToken',
              'partnerSharePhase', 'partnerShareMood', 'partnerShareSymptoms', 'partnerSharePredictions',
              'partnerSnapshot', 'lastPartnerCareAction']) && validSnapshot('partner'))))
        || (resource.data.status in ['PENDING', 'ACTIVE']
          && (resource.data.ownerUid == request.auth.uid || resource.data.partnerUid == request.auth.uid)
          && request.resource.data.status == 'REVOKED' && changedOnly(['status']))
        || (resource.data.status == 'PENDING' && resource.data.partnerUid == null
          && resource.data.ownerUid != request.auth.uid
          && request.resource.data.partnerUid == request.auth.uid
          && request.resource.data.status == 'ACTIVE'
          && changedOnly(['partnerUid', 'partnerDisplayName', 'partnerAvatarId', 'partnerFcmToken',
            'partnerSharePhase', 'partnerShareMood', 'partnerShareSymptoms', 'partnerSharePredictions', 'status']))
      );
      
      // Permitir borrado si:
      // 1. Eres el dueño o la pareja
      allow delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid || 
        resource.data.partnerUid == request.auth.uid
      );
    }

    // Invitaciones de pareja: desacopladas de partner_links (LUM-01)
    match /partner_invitations/{code} {
      // Listado estrictamente denegado: nadie puede enumerar o descubrir invitaciones a ciegas
      allow list: if false;

      // Lectura puntual por código: permitida solo conociendo el código exacto
      allow get: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.status == 'PENDING' && resource.data.expiresAtMs > request.time.toMillis())
      );

      // Creación: solo el titular puede emitir la invitación con caducidad válida
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.status == 'PENDING'
        && request.resource.data.expiresAtMs > request.time.toMillis();

      // Reclamo / revocación de invitación
      allow update: if request.auth != null && (
        (resource.data.status == 'PENDING'
          && resource.data.expiresAtMs > request.time.toMillis()
          && request.resource.data.status == 'CLAIMED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedByUid', 'claimedAtMs']))
        ||
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'REVOKED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    
    // Si tienes una colección "users" (opcional, asegúrala también)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /diaries/{linkId}/entries/{entryId} {
      // Solo los dos participantes de un vínculo ACTIVO pueden leer
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/partner_links/$(linkId))
        && get(/databases/$(database)/documents/partner_links/$(linkId)).data.status == 'ACTIVE'
        && (
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.ownerUid
            == request.auth.uid
          ||
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.partnerUid
            == request.auth.uid
        );

      // Solo pueden escribir si el vínculo está ACTIVO Y el authorUid coincide con quien escribe
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && exists(/databases/$(database)/documents/partner_links/$(linkId))
        && get(/databases/$(database)/documents/partner_links/$(linkId)).data.status == 'ACTIVE'
        && (
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.ownerUid
            == request.auth.uid
          ||
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.partnerUid
            == request.auth.uid
        );

      // Inmutable: nadie puede editar el texto de una entrada existente
      allow update: if false;

      // Poda autorizada: los participantes de un vínculo activo pueden borrar entradas antiguas
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/partner_links/$(linkId))
        && get(/databases/$(database)/documents/partner_links/$(linkId)).data.status == 'ACTIVE'
        && (
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.ownerUid
            == request.auth.uid
          ||
          get(/databases/$(database)/documents/partner_links/$(linkId)).data.partnerUid
            == request.auth.uid
        );
    }
  }
}
